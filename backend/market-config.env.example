# ============================================================
#  ATLAS Market Watch · 市场零件抓取
# ============================================================
# 复制为 market-config.env 后按需修改；不写这个文件时全部使用默认值。
# 修改后重启服务生效。

# 平台：mock（本地模拟） / 1688（真实抓取） / taobao / douyin
# 淘宝、抖音的 API 还在申请；1688 用 lib/source-1688.mjs 直接抓商品详情页。
MARKET_PLATFORM=mock

# ---- 1688 真实数据源 ----
# 匿名抓 https://m.1688.com/offer/<id>.html 会被滑块风控挡；三个缓解手段：
#   1) 拉长间隔（默认 3500ms，被挡过就调到 8000 以上）；
#   2) 在 seeds/1688-seeds.json 里按零件类型写死商品链接（最稳，不依赖搜索）；
#   3) 把浏览器登录 1688 后的整串 Cookie 贴到下面，风控会明显放松。
# 改了 Cookie 记得重启后端。
# MARKET_1688_COOKIE=cna=xxxx; __cn_logon__=true; cookie2=xxxx
# Cookie 太长不想写在这一行时：把整串存成文件，这里留空就会自动读（默认 data/1688-cookie.txt）
# MARKET_1688_COOKIE_FILE=./data/1688-cookie.txt
# MARKET_1688_DELAY_MS=3500
# 1688 默认绕开系统代理直连（走代理基本必被滑块拦）；需要走代理时改成 0
# MARKET_1688_DIRECT=1
# 每个零件类型最多抓几条（1~4）
# MARKET_1688_SEARCH_LIMIT=4
# 种子文件路径，默认 seeds/1688-seeds.json
# MARKET_1688_SEEDS_FILE=./seeds/1688-seeds.json

# 服务只监听本机；端口不要和一 / 二页（43125）冲突
MARKET_HOST=127.0.0.1
MARKET_PORT=43130

# 产品页地址（检查页里的"第一页 / 第二页"链接）
MARKET_APP_URL=http://127.0.0.1:43125

# 每天几点抓取（24 小时制，按下面的时区）
MARKET_DAILY_AT=08:00
MARKET_TIMEZONE=Asia/Shanghai

# 是否启用定时；接真实平台后再改成 1
MARKET_SCHEDULE_ENABLED=0

# 启动时是否立即跑一次
MARKET_RUN_ON_START=0

# 销量门槛：第 N 名的月销 × 比例
MARKET_SALES_RANK=10
MARKET_SALES_RATIO=0.7

# 异常价：偏离中位价的比例、最多剔除几轮
MARKET_OUTLIER_RATIO=0.4
MARKET_OUTLIER_ROUNDS=3

# 同款价格容差：超过就进人工审核
MARKET_SAME_PRICE_TOLERANCE=0.3

# AI 判定的最低置信度
MARKET_MIN_CONFIDENCE=0.6

# 每个零件类型最多抓多少条
MARKET_MAX_RESULTS=60

# 模拟数据默认不写回真实零件表（只生成 runs/<id>/parts.next.json）
# 做演示 / 测试时改成 1，并建议把 MARKET_PARTS_FILE 指向副本
MARKET_ALLOW_SIMULATED_WRITE=0

# AI：默认用整合包根目录的 ai-config.env（与第一 / 第二页共用同一份，改一次两端同时生效）
# 一般不用改；确需指向别处时才解开下一行：
# MARKET_AI_CONFIG_FILE=../ai-config.env
# 先用模拟 AI 跑通（不消耗调用）；接真实平台后改成 0
MARKET_AI_MOCK=1

# 零件库与表1（默认指向同级目录的 pages）
# MARKET_PARTS_FILE=../pages/public/data/h3-parts.json
# MARKET_TABLE1_FILE=../pages/presets/table1.json

# 运行数据（临时表、审核队列、备份）
# MARKET_DATA_DIR=./data
