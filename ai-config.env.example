# ============================================================
#  ATLAS v3.3 · 联网 AI 配置模板
#
#  用法：把本文件复制成同目录的 ai-config.env，填好下面的值并保存。
#        第一页 / 第二页（43125）和市场抓取后端（43130）都读这一份，
#        保存后无需重启：页面刷新即生效，后端在下一次抓取时生效。
#
#  全部留空 = 各端回落到本地预设函数（MOCK），可以完全离线演示。
#  也可以写小写键名（api_key / url / model），效果相同。
#
#  注意：ai-config.env 含明文 Key，不要外发、不要打进分发包。
# ============================================================

# 1) API Key —— 填了就进入联网模式
AI_API_KEY=

# 2) 接口地址 —— OpenAI 兼容的 /v1 根地址，不要带 /chat/completions
#    DeepSeek   https://api.deepseek.com
#    Kimi       https://api.kimi.com/coding/v1
#    OpenAI     https://api.openai.com/v1
#    通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#    本地 vLLM  http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.kimi.com/coding/v1

# 3) 模型名 —— 留空则按地址推断（DeepSeek → deepseek-chat，Kimi → moonshot-v1-8k，其它 → gpt-4o-mini）
AI_MODEL=kimi-for-coding

# Kimi 编程模型只接受 temperature=1；其它家可以删掉这行或改成 0.2
AI_TEMPERATURE=1

# ---------------- 以下可选 ----------------
# 右上角徽标显示的名称，默认按域名推断（DeepSeek / OpenAI / 通义千问 …）
# AI_PROVIDER_NAME=
# 单次请求超时（毫秒）
# AI_TIMEOUT_MS=90000
# 设为 1 可强制回退本地预设函数（调试用）；后端另有 MARKET_AI_MOCK 开关
# AI_MOCK=0
